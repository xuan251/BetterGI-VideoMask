# ============================================================
#  运行时产物：每个人机器上都不一样，绝不进仓库
# ============================================================

# 自己放进去的视频（几十上百 MB，且是别人的版权内容）
assets/videos/*
!assets/videos/放视频到这里.txt

# 点「截」按钮存下来的校准截图
assets/calib/*
!assets/calib/说明.txt

*.log

# ============================================================
#  开发 / 训练用的临时目录（本地十几 GB：音频、模型、转写稿）
# ============================================================

_vp/
dist/
node_modules/
__pycache__/
*.pyc

# 打包产物（走 GitHub Releases，不进 git 历史）
*.zip

# ============================================================
#  系统垃圾
# ============================================================

Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
